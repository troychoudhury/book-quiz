# ── Book Quiz — Environment Configuration ───────────────────────────
# Copy this file to `.env` (dev setup does this automatically) and
# adjust values for your machine. `.env` is gitignored — NEVER commit it.
#
# `.env` is the ONLY documented difference between local and production.
# Production secrets are injected via `fly secrets set` (see fly.toml).
# ─────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────
# Native mode: localhost. Docker mode: compose overrides to @db:5432.
POSTGRES_DB=bookquiz
POSTGRES_USER=bookquiz
# Generate with: openssl rand -hex 16   (dev setup does this for you)
DB_PASSWORD=bookquiz_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bookquiz:bookquiz_dev@localhost:5432/bookquiz

# ── Redis / Cache / Task Queue ───────────────────────────────────────
REDIS_PORT=6379
# Generate with: openssl rand -hex 16   (dev setup does this for you)
REDIS_PASSWORD=bookquiz_dev
REDIS_URL=redis://:bookquiz_dev@localhost:6379/0

# ── Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32   (dev setup does this for you)
JWT_SECRET_KEY=change-me-in-production

# ── OpenAI (required for AI question generation) ─────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── Admin ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 16   (dev setup does this for you)
ADMIN_API_KEY=admin-dev-key-change-me

# ── Rate Limiting ────────────────────────────────────────────────────
# Disabled by default in dev so rapid test requests are not throttled.
RATE_LIMIT_ENABLED=false

# ── Service Ports (override if you have conflicts) ───────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
